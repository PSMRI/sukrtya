# Environment Variables Template for Sukrtya Application
# Copy this file to .env and update with your actual values

# Application Configuration
SPRING_APPLICATION_NAME=sukrtya-api
SERVER_PORT=8080
APP_PORT=8080

# Database Configuration
DB_NAME=SUkrtya
DB_USERNAME=postgres
DB_PASSWORD=Psmri@2024
DB_PORT=5432

# JPA/Hibernate Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# Logging Configuration
LOGGING_LEVEL_ROOT=info
LOGGING_LEVEL_COM_PIRAMAL_SUKRTYA=INFO

# OpenTelemetry Configuration (Optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://your-otel-collector:55681/v1/traces

# Java Options
JAVA_OPTS=-Xms512m -Xmx1024m

# For Coolify Deployment:
# - Set these environment variables in Coolify's environment settings
# - Update DB_PASSWORD with a secure password
# - For production, use SPRING_JPA_HIBERNATE_DDL_AUTO=validate or none
# - Set SPRING_JPA_SHOW_SQL=false in production
