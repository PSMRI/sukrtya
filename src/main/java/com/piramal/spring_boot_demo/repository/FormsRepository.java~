package com.piramal.spring_boot_demo.repository;

import com.piramal.spring_boot_demo.DTO.ObjFormDTO;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.CrudRepository;
import org.springframework.data.repository.query.Param;
import org.springframework.stereotype.Repository;
import org.springframework.data.jpa.repository.JpaRepository;

import java.util.List;

@Repository
public interface FormsRepository extends CrudRepository<ObjFormDTO, Integer> {

    @Query(value = "SELECT DISTINCT " +
            "a.formid AS formID, " +
            "d.formname AS fromName, " +
            "b.facilitytypeid AS facilityTypeID, " +
            "TO_CHAR(a.createddate::DATE, 'DD/MM/YYYY') AS createdDate, " +
            "'' AS user, " +
            "'' AS approvedBy, " +
            "TO_CHAR(a.createddate::DATE, 'DD/MM/YYYY') AS submitDate, " +
            "TO_CHAR(a.createddate::DATE, 'DD/MM/YYYY') AS approvedDate, " +
            "'66887316340524' AS transactionId, " +
            "0 AS approvalStatus " +
            "FROM tblformmaster a " +
            "INNER JOIN tbl_regl_formname d ON a.formid = d.formid AND d.regl_formnameid = 1 " +
            "INNER JOIN tbl_regl_facilitytype b ON a.facilitytypeid = b.facilitytypeid AND b.reglid = 1 " +
            "WHERE a.facilitytypeid = :facilityTypeID AND a.isactive = :isActive", nativeQuery = true)
    List<ObjFormDTO> findDistinctForms(@Param("facilityTypeID") int facilityTypeID, @Param("isActive") int isActive);

//    List<ObjFormDTO> getObjFormData(@Param("facilityId") int facilityId,
//                                    @Param("formId") int formId,
//                                    @Param("facilityTypeId") int facilityTypeId);
}

