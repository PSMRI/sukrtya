package com.piramal.spring_boot_demo.services;
import com.piramal.spring_boot_demo.DTO.FacilityDTO;
import com.piramal.spring_boot_demo.DTO.UserResponseDTO;
import com.piramal.spring_boot_demo.repository.UserDetailsRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import java.util.List;
import java.util.stream.Collectors;

@Service
public class UserDetailsService {
    @Autowired
    private UserDetailsRepository userProfileRepository;

    public UserResponseDTO getUserProfileWithFacilities(String userName, String userPassword) {
        List<Object[]> results = userProfileRepository.findUserProfileWithFacilities(userName, userPassword);

        if (results.isEmpty()) {
            throw new UnauthorizedException("Invalid username or password");
        }

        Object[] userInfo = results.get(0);

        UserResponseDTO userResponse = new UserResponseDTO();
        userResponse.setUserName((String) userInfo[0]);
        userResponse.setPassword((String) userInfo[1]);
        userResponse.setUserTypeID((Integer) userInfo[2]);
        userResponse.setProfileID((Integer) userInfo[3]);
        userResponse.setUserID((Integer) userInfo[4]);
        userResponse.setProfileName((String) userInfo[5]);
        userResponse.setProfilePhoto((String) userInfo[6]);
        userResponse.setApprovalStatus((Integer) userInfo[7]);
        userResponse.setUserType((String) userInfo[8]);

        List<FacilityDTO> facilities = results.stream().map(result -> {
            FacilityDTO facility = new FacilityDTO();
            facility.setacilityID((Integer) result[9]);
            facility.setFacilityNameEN((String) result[10]);
            facility.setFacilityNameHI((String) result[11]);
            facility.setFacilityTypeID((Integer) result[12]);
            facility.setFacilityNIN((String) result[13]);
            facility.setFacilityAddress((String) result[14]);
            facility.setFacilityPincode((String) result[15]);
            facility.setFacilityLatitude((String) result[16]);
            facility.setFacilityLongitude((String) result[17]);
            facility.setFacilityPhoto((String) result[18]);
           // facility.setFacilityOwnershipTypeID((Integer) result[19]);
            facility.getFacilityOwnershipTypeId((Integer) result[19]);
            facility.setFacilityTimings((String) result[20]);
            //facility.setFacilityStateID((String) result[21]);
//            facility.setFacilityDistrictID((String) result[22]);
//            facility.setFacilityBlockID((String) result[23]);
//            facility.setFacilityTypeNameEN((String) result[24]);
//            facility.setFacilityTypeNameReg((String) result[25]);
//            facility.setFacilityOwnershipNameEN((String) result[26]);
//            facility.setFacilityOwnershipNameReg((String) result[27]);
//            facility.setFacilityBaseLocation((Integer) result[28]);
//            facility.setFacilityState((String) result[29]);
//            facility.setFacilityDistrict((String) result[30]);
//            facility.setFacilityBlock((String) result[31]);
//            facility.setRegLId((Integer) result[32]);
            return facility;
        }).collect(Collectors.toList());

        userResponse.setFacility(facilities);
        return userResponse;
    }
}
